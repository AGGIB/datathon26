# Разработка: без настроек используется локальное демо без отправки видео.
# Для подключения локального API:
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=false
# Production по умолчанию использует API на том же домене: оставьте URL пустым.
# Для явного демо в production задайте VITE_DEMO_MODE=true.
# Ключ передаётся в X-API-Key. При необходимости задайте выданный командой ключ
# здесь или в «Настройках подключения» интерфейса. Пустое значение оставляет ключ UI.
VITE_API_KEY=
