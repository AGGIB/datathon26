# Comma-separated API keys. First one is used by jury, second is used by UI.
API_KEYS=change-me-jury-key,change-me-ui-key
PIPELINE=mock
WORKERS=2
MAX_UPLOAD_MB=200
PIPELINE_TIMEOUT_SEC=200
JOB_TIMEOUT_SEC=270
MOCK_DELAY_SEC=2
DATA_DIR=./var
# FRONTEND_DIST=frontend/dist
# Optional Apple Silicon VLM; prepare local weights + isolated runtime first.
# See docs/vlm-type-quality.md. Start with WORKERS=1 when enabling.
ML_VLM_DISCOVERY=0
# ML_VLM_MODEL=/absolute/path/to/models/Qwen3-VL-4B-Instruct-4bit
# ML_VLM_PYTHON=/absolute/path/to/var/venvs/vlm-mlx/bin/python
